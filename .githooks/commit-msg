#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  echo "commit-msg: missing commit message file." >&2
  exit 1
fi

first_line="$(head -n 1 "$msg_file")"

if [[ "$first_line" =~ ^Merge\  ]]; then
  exit 0
fi

if [[ "$first_line" =~ ^Revert\  ]]; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?(!)?: .+'
if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "commit-msg: message must follow Conventional Commits." >&2
  echo "Examples: feat: add rss feed, fix(tags): correct encoding" >&2
  exit 1
fi
